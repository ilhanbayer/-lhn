[
 {"id": "a01", "text": "Bir memleket düşünün...", "exag": 0.45, "cfg": 0.3, "post": "normal", "gap": 2.0},
 {"id": "a02", "text": "Gündüzü cennet...", "exag": 0.5, "cfg": 0.35, "post": "warm", "gap": 0.9},
 {"id": "a03", "text": "Ama gecesi...", "exag": 0.55, "cfg": 0.3, "post": "dark", "gap": 0.9},
 {"id": "a04", "text": "Bambaşka bir âlem!", "exag": 0.75, "cfg": 0.3, "post": "lowbreath", "gap": 3.4},
 {"id": "a05", "text": "Burası Yahyalı...", "exag": 0.5, "cfg": 0.3, "post": "normal", "gap": 1.4},
 {"id": "a06", "text": "Burada her kayanın bir hikâyesi...", "exag": 0.5, "cfg": 0.35, "post": "normal", "gap": 0.7},
 {"id": "a07", "text": "Her ağacın bir sırrı...", "exag": 0.5, "cfg": 0.35, "post": "normal", "gap": 0.9},
 {"id": "a08", "text": "Ve bazı gecelerin, anlatılmaya cesaret edilemeyen hatıraları var.", "exag": 0.55, "cfg": 0.35, "post": "dark", "gap": 1.1},
 {"id": "a09", "text": "Kimi gördüğünü anlatamamış...", "exag": 0.5, "cfg": 0.35, "post": "normal", "gap": 0.6},
 {"id": "a10", "text": "Kimi yaşadıklarına kimseyi inandıramamış...", "exag": 0.5, "cfg": 0.35, "post": "normal", "gap": 1.0},
 {"id": "a11", "text": "Ama bazı hikâyeler var ki...", "exag": 0.5, "cfg": 0.32, "post": "normal", "gap": 0.6},
 {"id": "a12", "text": "Aradan yıllar geçse de unutulmamış!", "exag": 0.7, "cfg": 0.32, "post": "strong", "gap": 3.6},
 {"id": "b01", "text": "Yahyalı'nın yaylalarında...", "exag": 0.5, "cfg": 0.32, "post": "normal", "gap": 0.6},
 {"id": "b02", "text": "Beş büyük ardıcın gölgesinde...", "exag": 0.55, "cfg": 0.32, "post": "normal", "gap": 0.9},
 {"id": "b03", "text": "Kanlı Ardıç!", "exag": 0.95, "cfg": 0.3, "post": "strong", "gap": 1.6},
 {"id": "b04", "text": "Burası sıradan bir ağaçlık değil...", "exag": 0.55, "cfg": 0.35, "post": "normal", "gap": 0.6},
 {"id": "b05", "text": "Bir makam...", "exag": 0.55, "cfg": 0.3, "post": "normal", "gap": 0.9},
 {"id": "b06", "text": "Burada yatanın Süme olduğu söylenir.", "exag": 0.5, "cfg": 0.35, "post": "normal", "gap": 1.0},
 {"id": "b07", "text": "Ama burayı asıl gizemli yapan şey...", "exag": 0.6, "cfg": 0.32, "post": "normal", "gap": 0.6},
 {"id": "b08", "text": "Hakkında anlatılanlar!", "exag": 0.75, "cfg": 0.32, "post": "strong", "gap": 1.5},
 {"id": "b09", "text": "Rivayete göre...", "exag": 0.45, "cfg": 0.3, "post": "low", "gap": 0.7},
 {"id": "b10", "text": "Bir gün bir adam bu ağaçlardan odun keser.", "exag": 0.5, "cfg": 0.35, "post": "low", "gap": 0.8},
 {"id": "b11", "text": "Topladığı odunları çadırına taşır.", "exag": 0.5, "cfg": 0.35, "post": "low", "gap": 1.1},
 {"id": "b12", "text": "Gece olur...", "exag": 0.5, "cfg": 0.3, "post": "dark", "gap": 0.8},
 {"id": "b13", "text": "Dağ sessizliğe bürünür...", "exag": 0.5, "cfg": 0.3, "post": "dark", "gap": 1.0},
 {"id": "b14", "text": "Sabah uyandığında ise...", "exag": 0.55, "cfg": 0.3, "post": "normal", "gap": 2.0},
 {"id": "b15", "text": "Odunlar yoktur!", "exag": 1.0, "cfg": 0.35, "post": "strong", "gap": 1.5},
 {"id": "b16", "text": "Önce şaşırır...", "exag": 0.6, "cfg": 0.32, "post": "normal", "gap": 0.6},
 {"id": "b17", "text": "Sonra aynı ağaçlardan yeniden odun keser.", "exag": 0.6, "cfg": 0.35, "post": "normal", "gap": 0.5},
 {"id": "b18", "text": "Çadırına taşır.", "exag": 0.6, "cfg": 0.35, "post": "normal", "gap": 0.9},
 {"id": "b19", "text": "Ama ertesi sabah...", "exag": 0.65, "cfg": 0.3, "post": "normal", "gap": 0.6},
 {"id": "b20", "text": "Yine aynı manzara!", "exag": 0.8, "cfg": 0.32, "post": "strong", "gap": 0.6},
 {"id": "b21", "text": "Odunlar ortadan kaybolmuştur!", "exag": 0.85, "cfg": 0.35, "post": "strong", "gap": 1.1},
 {"id": "b22", "text": "Üçüncü kez dener...", "exag": 0.65, "cfg": 0.3, "post": "normal", "gap": 0.6},
 {"id": "b23", "text": "Ve yine...", "exag": 0.7, "cfg": 0.3, "post": "dark", "gap": 0.8},
 {"id": "b24", "text": "Hiçbir şey kalmamıştır!", "exag": 0.9, "cfg": 0.35, "post": "strong", "gap": 1.5},
 {"id": "b25", "text": "İşte o zaman korkuya kapılır...", "exag": 0.45, "cfg": 0.3, "post": "nearwhisper", "gap": 0.6},
 {"id": "b26", "text": "Bir daha o ağaçlardan tek bir dal bile almaya cesaret edemez.", "exag": 0.5, "cfg": 0.32, "post": "low", "gap": 3.2},
 {"id": "b27", "text": "Şimdi bir düşünün...", "exag": 0.4, "cfg": 0.25, "post": "low", "gap": 0.9},
 {"id": "b28", "text": "Gece yarısı...", "exag": 0.45, "cfg": 0.28, "post": "low", "gap": 0.7},
 {"id": "b29", "text": "Torosların ortasında...", "exag": 0.45, "cfg": 0.28, "post": "low", "gap": 0.7},
 {"id": "b30", "text": "Etrafınızda kimseden eser yok...", "exag": 0.5, "cfg": 0.28, "post": "low", "gap": 1.0},
 {"id": "b31", "text": "Ve sabaha karşı...", "exag": 0.55, "cfg": 0.3, "post": "low", "gap": 0.6},
 {"id": "b32", "text": "Bir gece önce kendi ellerinizle topladığınız odunlar...", "exag": 0.6, "cfg": 0.32, "post": "normal", "gap": 1.0},
 {"id": "b33", "text": "Yok!", "exag": 1.0, "cfg": 0.35, "post": "strong", "gap": 2.0},
 {"id": "b34", "text": "Peki...", "exag": 0.35, "cfg": 0.25, "post": "whisper", "gap": 0.7},
 {"id": "b35", "text": "Sizce o odunları kim aldı?", "exag": 0.35, "cfg": 0.25, "post": "whisper", "gap": 2.2},
 {"id": "b36", "text": "Belki de Kanlı Ardıç'ın sırrı...", "exag": 0.55, "cfg": 0.3, "post": "dark", "gap": 0.6},
 {"id": "b37", "text": "Hâlâ çözülmeyi bekliyordur!", "exag": 0.7, "cfg": 0.3, "post": "dark", "gap": 0.0}
]
